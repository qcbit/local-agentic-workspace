# =============================================================================
# Local Agentic Workspace - Environment Variables
# Copy this file to .env and fill in the values as needed.
# =============================================================================

# --- Phoenix / OpenTelemetry Tracing -----------------------------------------
# Set to "1", "true", or "yes" to enable Phoenix LLM tracing.
# Leave unset or empty to disable tracing.
PHOENIX_TRACING=

# The Phoenix project name used for tracing metadata.
# Default: orchestrator-token-baseline
PHOENIX_PROJECT_NAME=orchestrator-token-baseline

# The Phoenix collector OTLP endpoint for trace ingestion.
# Default: http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=1024

# --- Build / Versioning -------------------------------------------------------
# Build version string appended to trace metadata for provenance tracking.
# Default: local
BUILD_VERSION=local

# --- Network / Proxy ----------------------------------------------------------
# Optional proxy URLs for LLM API requests. Leave blank if no proxy is needed.
HTTP_PROXY=
HTTPS_PROXY=

