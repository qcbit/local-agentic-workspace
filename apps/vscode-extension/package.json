{
  "name": "local-agentic-workspace",
  "displayName": "Local Agentic Workspace",
  "version": "0.1.0",
  "description": "Air-gapped local agentic coding assistant for VS Code",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onCommand:localAgentic.testAST"
  ],
  "contributes": {
    "configuration": {
      "title": "Local Agentic Workspace",
      "properties": {
        "localAgentic.activeProfile": {
          "type": "string",
          "default": "local-ollama",
          "description": "The ID of the currently active BYOA profile."
        },
        "localAgentic.profiles": {
          "type": "array",
          "default": [
            {
              "id": "local-ollama",
              "name": "Home (Ollama)",
              "endpointUrl": "http://127.0.0.1:11434",
              "apiKey": "none",
              "model": "llama3"
            },
            {
              "id": "work-azure",
              "name": "Work (Azure Foundry)",
              "endpointUrl": "https://your-enterprise-endpoint.azure.com/v1/chat/completions",
              "apiKey": "YOUR_AZURE_KEY",
              "model": "gpt-4-turbo"
            }
          ],
          "description": "Array of LLM profiles for dynamic proxy routing."
        }
      }
    },
    "commands": [
      {
        "command": "localAgentic.switchProfile",
        "title": "LocalAgentic: Switch AI Profile"
      },
      {
        "command": "localAgentic.testAST",
        "title": "LocalAgentic: testAST"
      },
      {
        "command": "localAgentic.showProposedDiff",
        "title": "LocalAgentic: Show Proposed Diff"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localAgenticContainer",
          "title": "Local Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "localAgenticContainer": [
        {
          "type": "webview",
          "id": "localAgenticChat",
          "name": "Agent Chat & State",
          "icon": "resources/icon.svg",
          "contextualTitle": "Local Agentic Assistant"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha -r ts-node/register \"test/**/*.spec.ts\""
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/emscripten": "^1.39.10",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "chai": "^4.3.8",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "web-tree-sitter": "^0.26.11"
  }
}
